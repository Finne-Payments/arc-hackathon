{
  "name": "finne-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Finné backend — Express REST API over MongoDB. Dispute system for stablecoin payouts on Circle's Refund Protocol.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"node --env-file=.env --import tsx/esm src/server.ts\"",
    "start": "node --env-file=.env --import tsx/esm src/server.ts",
    "seed": "node --env-file=.env --import tsx/esm src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "js-sha3": "^0.9.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "8.9.5",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
