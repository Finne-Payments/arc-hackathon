# Finné backend environment.
# Copy to `.env` and adjust. See backend/README.md for setup.

# --- MongoDB (Atlas or local) ---
MONGO_URL=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/finne?retryWrites=true&w=majority

# --- HTTP ---
BACKEND_PORT=4000

# --- Auth (demo grade — D7) ---
INTERNAL_TOKEN=dev-internal
SESSION_SECRET=change-me

# --- Demo mode ---
DEMO_MODE=true

# --- Arc testnet (Circle's Arc blockchain) ---
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_CHAIN_NAME=Arc Testnet
ARC_EXPLORER_URL=https://testnet.arcscan.app

# --- Contract addresses (set after deploying via contracts/.env.deploy +
#     scripts/deploy-arc.sh). Empty = backend boots but money endpoints 503. ---
REFUND_PROTOCOL_ADDRESS=0x6EE86fEE126C94CD3bE0d2a5187F69368965f989
CASE_REGISTRY_ADDRESS=0x9Db75cf6B7Ecb6efDac5C141E17bE3884a3e6D4d

# --- Arc testnet USDC (native, 6 decimals as ERC-20) ---
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- The ONE Finné-held key (hash-anchor only) ---
REGISTRY_OPERATOR_PRIVATE_KEY=

# --- Policy fallback ---
RESPONSE_WINDOW_HOURS=72

# --- Indexer rolling window ---
# Each tick the indexer scans this many recent blocks of contract activity (pays,
# refunds, withdrawals, anchors) — NOT the whole chain from deploy. Default 5000
# (~7 min of Arc blocks) catches fresh actions even if a tick is missed; replays
# are deduped by the {txHash, logIndex} unique index. For an explicit historical
# catch-up use `BACKFILL_FROM_BLOCK=<block> node src/backfill.ts`.
INDEXER_LOOKBACK_BLOCKS=5000

# --- Model runtime (self-hosted by default; see root .env.example + docs/models.md) ---
# provider=openai-compatible (default, P9/D7): set MODEL_BASE_URL to a running
#   vLLM (http://model:8000/v1) or Ollama (http://host.docker.internal:11434/v1).
#   Empty/disabled MODEL_BASE_URL = models-unplugged (FIN-105, every station
#   degrades to templates + computation).
# provider=bedrock (HACKATHON EXCEPTION — hosted external model, deviates from
#   P9/D7): requires MODEL_BEDROCK_HACKATHON_OPT_IN=true + AWS_REGION + IAM creds
#   (AWS_PROFILE / AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY). Bedrock uses IAM,
#   not an API key. Set MODEL_NAME to a Bedrock model id, e.g.
#   amazon.nova-lite-v1:0. MODEL_BASE_URL is ignored in this mode.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
MODEL_TIMEOUT_MS=5000
MODEL_BEDROCK_HACKATHON_OPT_IN=

# --- Evidence storage (S3 bucket, provisioned by CDK) ---
# When set, uploads/downloads use S3 (durable, presigned URLs, survives restarts).
# Leave empty for the in-memory local store (dev/test only — lost on restart).
EVIDENCE_BUCKET=finne-evidence-042122908120-us-east-1
