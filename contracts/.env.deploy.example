# ============================================================================
# Template for contracts/.env.deploy — copy to .env.deploy and fill in REAL keys.
#   cp contracts/.env.deploy.example contracts/.env.deploy
#
# SECURITY:
#   * .env.deploy is GITIGNORED (.gitignore covers .env.*). Never commit it.
#   * These are MONEY-MOVING keys, consumed ONLY by `forge script` / `cast send`
#     at deploy time. The running backend must NEVER see them — its boot-fail
#     guard (backend/src/env.ts::assertNoMoneyKeys) crashes if it does.
#   * The only key the backend ever holds is REGISTRY_OPERATOR_PRIVATE_KEY,
#     copied into backend/.env by scripts/deploy-arc.sh after deploy.
#
# All five roles can be derived from a single mnemonic at m/44'/60'/0'/0/{0..4}
# (testnet only). Put placeholder values here; fill the real ones in .env.deploy.
# ============================================================================

ARC_RPC_URL=https://rpc.testnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---- Roles (derived from the mnemonic at m/44'/60'/0'/0/{0..4}) ----
DEPLOYER_ADDRESS=0x0000...
DEPLOYER_PRIVATE_KEY=0x0000...
OPERATOR_ADDRESS=0x0000...
OPERATOR_PRIVATE_KEY=0x0000...
ARBITER_ADDRESS=0x0000...
ARBITER_PRIVATE_KEY=0x0000...
PAYER_ADDRESS=0x0000...
PAYER_PRIVATE_KEY=0x0000...
RECIPIENT_ADDRESS=0x0000...
# Refunds return to the treasury (deployer address by convention).
REFUND_TO_ADDRESS=0x0000...

# ---- Amounts (base units, 6 decimals). Defaults fit 40 USDC faucet funding. ---
RESERVE_AMOUNT=30000000        # 30 USDC arbiter reserve
PAY_TRANCHE_AMOUNT=10000000    # 10 USDC per demo payout (3 payouts)
