{
  "name": "@finne/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain types for Finné — roles, states, events, opaque IDs, micro-USDC helpers, and schemas.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./roles": "./src/roles.ts",
    "./states": "./src/states.ts",
    "./ids": "./src/ids.ts",
