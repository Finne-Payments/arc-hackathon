# =============================================================================
# Finné — environment configuration (FND-04 typed config).
# Copy to `.env` and fill in real values. Every var here is read by
# @finne/config's Zod-validated loader. Staging/submission stages fail on
# placeholders, wrong chain, or missing required addresses.
#
# Variables marked [REQUIRED FOR STAGING/SUBMISSION] must be set with real
# values before the app can boot in those stages. Local/test stages tolerate
# the defaults shown here.
# =============================================================================

# --- Stage (local | test | staging | submission) ---
NODE_ENV=local

# --- MongoDB [REQUIRED FOR STAGING/SUBMISSION] ---
# Local: mongodb://127.0.0.1:27017/finne
# Production: MongoDB Atlas connection string (TLS, least-privilege user)
MONGO_URL=mongodb://127.0.0.1:27017/finne

# --- HTTP ---
BACKEND_PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- Auth / session [REQUIRED FOR STAGING/SUBMISSION — must be real, not placeholder] ---
SESSION_SECRET=local-dev-secret-minimum-16-chars
INTERNAL_TOKEN=local-internal-token-min-16

# --- Demo mode ---
# true gates demo-only routes (POST /v1/demo/payouts). Set false for production.
DEMO_MODE=true

# --- Response window (hours) ---
RESPONSE_WINDOW_HOURS=72

# =============================================================================
# Arc Testnet chain config
# =============================================================================

ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_CHAIN_NAME=Arc Testnet
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_FINALITY_BLOCKS=3

# --- Arc testnet USDC (native, 6 decimals) [REQUIRED FOR STAGING/SUBMISSION] ---
# The faucet-funded USDC address on Arc testnet.
ARC_USDC_ADDRESS=

# --- Arc system emitter + Memo address (for dual-event decoding, INT-02) ---
ARC_SYSTEM_EMITTER=
ARC_MEMO_ADDRESS=

# =============================================================================
# FinneCaseRegistry contract (the sole Finné contract)
# =============================================================================

# [REQUIRED FOR STAGING/SUBMISSION] — set after CON-06 deploys to Arc testnet.
# The production FinneCaseRegistry address (AccessControl + Pausable registrar).
# Currently deployed at: 0x297730EaF53C95B9d8322b9Af5e48b47227D1e82
CASE_REGISTRY_ADDRESS=

# --- The ONE Finné-held key (hash-anchor only, ADR 0004) ---
# Can ONLY call anchorReceipt/anchorCase/anchorDecision on the CaseRegistry.
# It cannot move USDC — the registry has no transfer code. Without it, anchor
# jobs queue but never post (warned at boot).
REGISTRY_OPERATOR_PRIVATE_KEY=

# =============================================================================
# Role-holder wallets (CON-01, INT-04)
# Separate approved testnet addresses for each role. [REQUIRED FOR STAGING]
# =============================================================================
PLATFORM_PAYOUT_WALLET=
REGISTRY_PLATFORM_WALLET=
REVIEWER_WALLET=
AGENT_WALLET=
REGISTRY_ADMIN_WALLET=

# =============================================================================
# Circle integration (INT-04, INT-05, INT-06)
# Server client for Circle Wallets / Gas Station on Arc testnet.
# Secret references only — never raw entity secrets in the repo.
# [REQUIRED for INT-04/05/06/07 — provided later]
# =============================================================================
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# =============================================================================
# AWS / storage adapters (AWS-02)
# Private versioned S3 evidence bucket + SQS queue + KMS.
# Deployed via CDK to the account/region below, least-privilege (no static keys).
# AWS_ACCOUNT_ID + AWS_REGION are read by infra/cdk/bin/finne.ts at synth time;
# they must be exported (or provided via an AWS profile) before `cdk deploy`.
# [REQUIRED for PAY-02 (evidence storage) and AWS-02 — provided later]
# =============================================================================
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
AWS_PROFILE=finne
EVIDENCE_BUCKET=
KMS_KEY_ID=
SQS_QUEUE_URL=
SQS_DLQ_URL=

# =============================================================================
# Identity provider / OIDC (BE-04)
# Cognito or equivalent for operations + reviewer auth.
# [REQUIRED for BE-04 (controlled platform auth) — provided later]
# =============================================================================
IDP_ISSUER=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_AUDIENCE=
