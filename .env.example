# Finné Docker deployment environment.
# Copy to `.env` (next to docker-compose.yml) and fill in real values, then
# `docker compose up --build`. These vars are injected into the backend container.
# Variable names mirror backend/.env.example exactly.

# --- MongoDB (Atlas — kept external, not a container here) ---
# From scripts/demo.sh. Replace with your own cluster.
MONGO_URL=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/finne?retryWrites=true&w=majority

# --- HTTP ---
BACKEND_PORT=4000

# --- Auth (demo grade — D7) ---
INTERNAL_TOKEN=dev-internal
SESSION_SECRET=change-me

# --- Demo mode ---
# true is correct for the demo (gates /demo/seed). Set 'false' for any real use (PRD §18.2).
DEMO_MODE=true

# --- Arc testnet (Circle's Arc blockchain) ---
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_CHAIN_NAME=Arc Testnet
ARC_EXPLORER_URL=https://testnet.arcscan.app

# --- Contract addresses (set AFTER deploying contracts to Arc testnet via the
#     forge scripts in contracts/refund-protocol/script/). Empty = anchoring /
#     chain reads degrade gracefully but the app is inert without them. ---
REFUND_PROTOCOL_ADDRESS=
CASE_REGISTRY_ADDRESS=

# --- Arc testnet USDC (native, 6 decimals as ERC-20) ---
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- The ONE Finné-held key (hash-anchor only).
#     Can ONLY call anchorReceipt/anchorCase/anchorDecision on the CaseRegistry.
#     It cannot move USDC — the CaseRegistry has no transfer code (PRD §4.1).
#     Without it, anchors queue but never post (warned at boot). ---
REGISTRY_OPERATOR_PRIVATE_KEY=

# --- Policy fallback (hours, used when platform policy absent) ---
RESPONSE_WINDOW_HOURS=72
